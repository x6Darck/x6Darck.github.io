---
const es = new URL('/es/', Astro.site).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jean Pier Gómez</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={es} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).href} />
    <noscript><meta http-equiv="refresh" content="0;url=/es/" /></noscript>
    <script is:inline>
      var l = (navigator.language || 'es').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
      location.replace('/' + l + '/' + location.hash);
    </script>
  </head>
  <body>
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
