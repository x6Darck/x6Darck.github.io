---
interface Props { id: string; title: string; class?: string }
const { id, title, class: cls = '' } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-title`} class="relative" data-section>
  <div class="wrap">
    <div class="rule" data-reveal></div>
    <div class:list={['grid gap-8 py-16 md:grid-cols-[220px_minmax(0,1fr)] md:gap-12 md:py-24', cls]}>
      <div class="md:sticky md:top-[calc(var(--nav-h)+32px)] md:self-start" data-reveal>
        <h2 id={`${id}-title`} class="h2">{title}</h2>
        <slot name="aside" />
      </div>
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</section>
