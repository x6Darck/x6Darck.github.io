---
import Section from './Section.astro';
import { dict, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang].about;
---
<Section id="about" title={t.title}>
  <p class="max-w-[58ch] text-[1.1875rem] leading-[1.6] text-fg" data-reveal>{t.p1}</p>
  <p class="mt-5 max-w-[58ch] text-muted" data-reveal style="--i:1">{t.p2}</p>
  <dl class="mt-10 grid gap-x-8 sm:grid-cols-2">
    {t.facts.map((f, i) => (
      <div class="border-t border-line py-4" data-reveal style={`--i:${i + 2}`}>
        <dt class="text-sm text-faint">{f.k}</dt>
        <dd class="mt-1 font-medium">{f.v}</dd>
      </div>
    ))}
  </dl>
</Section>
