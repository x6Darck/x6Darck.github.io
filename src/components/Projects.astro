---
import Section from './Section.astro';
import Diagram from './Diagram.astro';
import Icon from './Icon.astro';
import { dict, projectsMeta, filterTags, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang].projects;
---
<Section id="projects" title={t.title}>
  <Fragment slot="aside">
    <p class="mt-3 text-muted">{t.intro}</p>
    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label={t.filterLabel} data-filters>
      <button type="button" class="chip" aria-pressed="true" data-filter="all">{t.all}</button>
      {filterTags.map((tag) => <button type="button" class="chip" aria-pressed="false" data-filter={tag}>{tag}</button>)}
    </div>
    <p class="mt-4 text-sm text-faint" aria-live="polite" data-count data-one={t.countOne} data-many-template={t.countMany(0)}>{t.countMany(projectsMeta.length)}</p>
  </Fragment>

  <div class="flex flex-col gap-16">
    {projectsMeta.map((p) => {
      const c = t.items[p.id];
      return (
        <article class="min-w-0" data-project data-stack={p.stack.join('|')} aria-labelledby={`p-${p.id}`}>
          <header data-reveal>
            <p class="mono text-sm text-faint">{p.year}</p>
            <h3 id={`p-${p.id}`} class="mt-1 text-2xl font-semibold tracking-tight">{c.title}</h3>
            <p class="mt-2 max-w-[56ch] text-muted">{c.tagline}</p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
              {p.stack.map((s) => <li class="chip">{s}</li>)}
            </ul>
          </header>

          <p class="mt-6 flex items-start gap-3 rounded-lg bg-accent-soft p-4 font-medium" data-reveal>
            <span class="mt-0.5 text-accent"><Icon name={p.id === 'farmstock' ? 'wifi-slash' : 'plugs-connected'} size={22} /></span>
            <span>{c.highlight}</span>
          </p>

          <dl class="mt-8 grid gap-x-8 gap-y-6 lg:grid-cols-2">
            <div data-reveal>
              <dt class="text-sm font-medium text-faint">{t.problem}</dt>
              <dd class="mt-1.5 text-[0.9688rem]">{c.problem}</dd>
            </div>
            <div data-reveal style="--i:1">
              <dt class="text-sm font-medium text-faint">{t.solution}</dt>
              <dd class="mt-1.5 text-[0.9688rem]">{c.solution}</dd>
            </div>
            <div class="lg:col-span-2" data-reveal>
              <dt class="text-sm font-medium text-faint">{t.architecture}</dt>
              <dd class="mt-1.5">
                <ul class="grid gap-x-8 gap-y-2 text-[0.9688rem] sm:grid-cols-2">
                  {c.architecture.map((a) => <li class="border-t border-line pt-2">{a}</li>)}
                </ul>
              </dd>
            </div>
          </dl>

          <div class="mt-8" data-reveal>
            <Diagram project={p.id} texts={c.diagram} defaultNode={p.defaultNode} label={t.diagramLabel} hint={t.diagramHint} />
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2" data-reveal>
            <span class="text-sm text-faint">{t.repos}</span>
            {p.repos.map((r) => (
              <a class="link mono inline-flex min-h-[44px] items-center gap-1.5 text-sm" href={r.href} target="_blank" rel="noopener">
                <Icon name="github-logo" size={16} />{r.label}
                <Icon name="arrow-up-right" size={14} class="arrow" />
              </a>
            ))}
          </div>
        </article>
      );
    })}
  </div>
</Section>
