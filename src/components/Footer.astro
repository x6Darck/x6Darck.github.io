---
import { dict, profile, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
---
<footer class="border-t border-line py-8 text-sm text-faint">
  <div class="wrap flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <p>© 2026 {t.footer.rights}</p>
    <p class="flex items-center gap-4">
      <a class="link text-muted" href={profile.github} rel="me noopener" target="_blank">GitHub</a>
      <a class="link text-muted" href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <span>{t.footer.built}</span>
    </p>
  </div>
</footer>
