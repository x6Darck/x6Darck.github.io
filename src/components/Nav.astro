---
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<header class="nav" data-nav>
  <div class="wrap flex h-full items-center justify-between gap-3">
    <a href={`/${lang}/`} class="font-semibold tracking-tight" aria-label={`Jean Pier Gómez, ${t.ui.home}`}>
      Jean Pier <span class="text-muted">Gómez</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.ui.navLabel}>
      {t.nav.map((n) => <a class="nav-link" href={`#${n.id}`} data-spy={n.id}>{n.label}</a>)}
    </nav>

    <div class="flex items-center gap-1">
      <a class="icon-btn mono text-[0.8125rem] font-medium" href={`/${other}/`} hreflang={other} lang={other} aria-label={t.ui.langSwitch} data-lang-switch>{t.ui.langShort}</a>
      <button class="icon-btn" type="button" aria-label={t.ui.theme} data-theme-toggle>
        <Icon name="sun" class="sun" />
        <Icon name="moon" class="moon" />
      </button>
      <button class="icon-btn md:hidden" type="button" aria-expanded="false" aria-controls="menu" aria-label={t.ui.menuOpen} data-menu-toggle data-label-open={t.ui.menuOpen} data-label-close={t.ui.menuClose}>
        <Icon name="list" class="menu-open" />
        <Icon name="x" class="menu-close hidden" />
      </button>
    </div>
  </div>
</header>

<div id="menu" class="menu-panel md:hidden" data-menu data-open="false">
  <nav aria-label={t.ui.navLabel}>
    {t.nav.map((n) => <a class="menu-link" href={`#${n.id}`} data-spy={n.id}>{n.label}</a>)}
  </nav>
</div>
