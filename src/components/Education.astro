---
import Section from './Section.astro';
import { dict, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang].education;
---
<Section id="education" title={t.title}>
  <ul class="flex flex-col">
    {t.items.map((e, i) => (
      <li class="flex flex-col gap-1 border-t border-line py-5 first:border-t-0 first:pt-0 sm:flex-row sm:items-baseline sm:justify-between" data-reveal style={`--i:${i}`}>
        <div>
          <h3 class="font-semibold tracking-tight">{e.name}</h3>
          <p class="text-muted">{e.org}</p>
        </div>
        <p class="mono text-sm text-faint">{e.period}</p>
      </li>
    ))}
  </ul>
  <div class="mt-8 border-t border-line pt-6" data-reveal>
    <h3 class="text-sm font-medium text-faint">{t.langTitle}</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {t.langs.map((l) => (
        <li class="chip" style="font-family: var(--f-sans)">{l.name}: {l.level}</li>
      ))}
    </ul>
  </div>
</Section>
