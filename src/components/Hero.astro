---
import Icon from './Icon.astro';
import Diagram from './Diagram.astro';
import { dict, profile, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
const gea = t.projects.items.gea.diagram;
---
<section id="hero" class="relative" aria-label={t.hero.title} data-section>
  <div class="wrap flex min-h-[100dvh] flex-col justify-center gap-10 pb-16 pt-[calc(var(--nav-h)+40px)] lg:gap-14">
    <h1 class="h1" data-reveal>{t.hero.title}</h1>

    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div>
        <p class="lead" data-reveal style="--i:1">{t.hero.sub}</p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--i:2">
          <a class="btn btn-primary" href="#projects">
            {t.hero.ctaProjects}
            <Icon name="arrow-down" size={18} />
          </a>
          <a class="btn" href={profile.cv[lang]} download>
            <Icon name="download-simple" size={18} />
            {t.hero.ctaCv}
          </a>
        </div>
        <p class="mt-7 inline-flex items-center gap-2 text-sm text-muted" data-reveal style="--i:3">
          <Icon name="map-pin" size={16} />
          {t.hero.meta}
        </p>
      </div>

      <div class="hero-visual hidden sm:block" role="img" aria-label={t.hero.visualLabel} data-reveal style="--i:2">
        <div class="rounded-lg border border-line bg-surface p-5">
          <Diagram project="gea" texts={gea} interactive={false} hero label={t.hero.visualLabel} />
        </div>
      </div>
    </div>
  </div>
</section>
<!-- [PENDIENTE] foto profesional: si se aporta, usarla en Sobre mi o junto al hero -->
