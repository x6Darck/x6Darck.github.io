---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { dict, profile, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const site = Astro.site!;
const url = (l: Lang) => new URL(`/${l}/`, site).href;
const canonical = url(lang);
const ogImage = new URL('/og.png', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: canonical,
  jobTitle: lang === 'es' ? 'Desarrollador Full Stack Junior' : 'Junior Full Stack Developer',
  address: { '@type': 'PostalAddress', addressLocality: 'Cúcuta', addressCountry: 'CO' },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: ['Java', 'Spring Boot', 'Spring Security', 'REST APIs', 'React', 'Angular', 'Flutter', 'Electron', 'MySQL', 'Docker'],
  alumniOf: { '@type': 'EducationalOrganization', name: 'SENA' },
};
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={url('es')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={url('es')} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.htmlLang.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var s = localStorage.getItem('theme');
          d.dataset.theme = s || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
        d.classList.add('js');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-3 focus:text-accent-fg">{t.ui.skip}</a>
    <div id="top-sentinel" aria-hidden="true" class="absolute left-0 top-0 h-px w-px"></div>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
